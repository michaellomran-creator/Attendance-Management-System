# =============================================================================
# NORAM ATTENDANCE PLATFORM — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy to .env for local development. Never commit real secrets.
# =============================================================================

# Database (PostgreSQL)
POSTGRES_DB=attendance_platform
POSTGRES_USER=attendance_user
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://attendance_user:CHANGE_ME_LOCAL_DEV_PASSWORD@localhost:5432/attendance_platform

# Backend Security & JWT
APP_ENV=development
APP_NAME=NORAM Attendance Platform
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_64_CHAR_HEX_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
TERMINAL_RESET_DELAY_SECONDS=4
PIN_MAX_FAILED_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://staff-attendance-brown.vercel.app
BACKEND_CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Initial Platform Super Admin (Development Seed Only)
SEED_DEMO_DATA=false
PLATFORM_ADMIN_EMAIL=platform-admin@noramdigital.com
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_DEV_ADMIN_PASSWORD

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=NORAM Attendance
